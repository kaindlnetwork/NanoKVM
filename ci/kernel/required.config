# Pflicht-Optionen fuer den NanoKVM (Kernel 5.10, SG2002).
# Fehlt eine, funktioniert eine Kernfunktion nicht. Format: Kconfig-Fragment,
# mit scripts/kconfig/merge_config.sh verwendbar. Pruefung: ci/kconfig_check.py.
# Herleitung und Belege: docs/fork/kernel/README.md

# Grund: SoC-Grundlage, Herstellertreiber soph_* (Videokette, Encoder) setzen ION, CMA und dma-buf voraus
CONFIG_ARCH_CVITEK=y
CONFIG_ARCH_CV181X=y
CONFIG_ION=y
CONFIG_ION_CVITEK=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_MODULES=y

# Grund: Pinmux des SoC; Voraussetzung, um devmem-Aufrufe durch Device-Tree-Pinmux zu ersetzen
CONFIG_CVITEK_PINCTRL_CV1835=y

# Grund: Speicher (SD/eMMC), Root-Dateisystem ext4, Boot-Partition vfat, Datenpartition exfat (server/service/storage/media.go)
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_CVI=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y

# Grund: ISO-/Image-Einhaengen ueber losetup (server/service/storage/diskfs, Probe prueft /dev/loop-control)
CONFIG_BLK_DEV_LOOP=y

# Grund: USB-Gadget zum Zielrechner: Tastatur/Maus (hid.GS*) und virtueller Datentraeger (mass_storage.disk0), kvmapp/system/init.d/S03usbdev
CONFIG_USB_DWC2=y
CONFIG_USB_GADGET=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# Grund: Power/Reset/LEDs ueber sysfs-GPIO (server/service/vm, S15kvmhwd), OLED und HDMI-Wandler LT6911 ueber I2C (kvm_system), Taster ueber evdev
CONFIG_GPIOLIB=y
CONFIG_GPIO_DWAPB=y
CONFIG_GPIO_SYSFS=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_GPIO=m
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y

# Grund: Ethernet und IP-Stack, udhcpc braucht AF_PACKET
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y

# Grund: Firewall; S95nanokvm nutzt iptables mit -m state, ein kuenftiger Regelsatz nftables (inet)
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NETFILTER_XT_MATCH_STATE=y

# Grund: Betriebssicherheit: Watchdog (soph_wdt, kvm_system ueberwacht den Videodienst), Uhr, Temperaturschutz
CONFIG_WATCHDOG=y
CONFIG_RTC_CLASS=y
CONFIG_THERMAL=y
CONFIG_CV181X_THERMAL=y

# Grund: Prozess-Haertung (Stufe 2 des Root-Plans): seccomp-Filter im Server
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Grund: vorerst noetig, S15kvmhwd und kvm_system setzen Pinmux per devmem; entfaellt nach Umstellung auf Device-Tree-Pinmux (siehe remove-Kandidaten in docs/fork/kernel/README.md)
CONFIG_DEVMEM=y

# Grund: /proc/config.gz macht die Konfiguration auf dem Geraet pruefbar (Abgleich mit diesem Fragment)
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
