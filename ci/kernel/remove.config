# Kernel-Optionen, die der NanoKVM nicht braucht und die Angriffsflaeche
# sind. Format: Kconfig-Fragment. Jeder Block mit Beleg, warum es entbehrlich
# ist. Herleitung: docs/fork/kernel/README.md

# Grund: Bluetooth; keine Bluetooth-Hardware genutzt, kvm_system loescht S40bluetoothd selbst
# CONFIG_BT is not set
# CONFIG_BT_RFCOMM is not set
# CONFIG_BT_BNEP is not set
# CONFIG_BT_HIDP is not set
# CONFIG_BT_HCIUART is not set

# Grund: Audio und Mikrofon; kein Audio-Code in Server, Web-UI, libkvm oder kvm_system (Upstream-Issue #693 zum eingebauten Mikrofon)
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_SND_SOC is not set
# CONFIG_USB_CONFIGFS_F_UAC1 is not set

# Grund: Display, Hintergrundbeleuchtung, Touch; NanoKVM hat kein Panel, kvm_system loescht S04backlight und S05tp
# CONFIG_FB is not set
# CONFIG_FB_SIMPLE is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_TOUCHSCREEN_HYNITRON_TS is not set

# Grund: Kameras; Video kommt ueber MIPI-CSI vom LT6911 (soph_mipi_rx), nicht ueber USB-Kameras oder MIPI-TX
# CONFIG_USB_VIDEO_CLASS is not set
# CONFIG_MEDIA_USB_SUPPORT is not set
# CONFIG_USB_CONFIGFS_F_UVC is not set
# CONFIG_VIDEO_CVITEK_MIPI_TX is not set

# Grund: USB-Host-Klassentreiber; der Port laeuft als Gadget, die Rolle "host" in S03usbdev ist nur Zwischenzustand beim Neustart des Gadgets
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_USB_ACM is not set
# CONFIG_USB_NET_RNDIS_WLAN is not set

# Grund: ungenutzte Gadget-Funktionen; S03usbdev legt nur hid, mass_storage, rndis und ncm an
# CONFIG_USB_CONFIGFS_SERIAL is not set
# CONFIG_USB_CONFIGFS_ACM is not set
# CONFIG_USB_CONFIGFS_ECM is not set
# CONFIG_USB_CONFIGFS_EEM is not set
# CONFIG_USB_CONFIGFS_F_FS is not set

# Grund: Flash- und Netz-Dateisysteme; der NanoKVM bootet von SD/eMMC, nicht von NAND oder NFS
# CONFIG_MTD is not set
# CONFIG_MTD_UBI is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_ROOT_NFS is not set

# Grund: Tunnel; Tailscale nutzt TUN (wireguard-go im Userspace), kein Kernel-WireGuard, kein GRE/SIT
# CONFIG_WIREGUARD is not set
# CONFIG_IPV6_TUNNEL is not set
# CONFIG_IPV6_GRE is not set
# CONFIG_IPV6_SIT is not set
# CONFIG_VETH is not set

# Grund: Conntrack-/NAT-Helfer parsen fremde Protokolle im Kernel (klassische Angriffsflaeche), ein KVM routet nichts davon
# CONFIG_NF_CONNTRACK_AMANDA is not set
# CONFIG_NF_CONNTRACK_FTP is not set
# CONFIG_NF_CONNTRACK_H323 is not set
# CONFIG_NF_CONNTRACK_IRC is not set
# CONFIG_NF_CONNTRACK_NETBIOS_NS is not set
# CONFIG_NF_CONNTRACK_SNMP is not set
# CONFIG_NF_CONNTRACK_PPTP is not set
# CONFIG_NF_CONNTRACK_SANE is not set
# CONFIG_NF_CONNTRACK_SIP is not set
# CONFIG_NF_CONNTRACK_TFTP is not set
# CONFIG_NETFILTER_XT_MATCH_BPF is not set
# CONFIG_IP_NF_TARGET_CLUSTERIP is not set
# CONFIG_NFT_OSF is not set
# CONFIG_NETFILTER_XT_MATCH_OSF is not set

# Grund: Userspace-Zugriff auf Busse und Eingabe, den nichts nutzt: spidev, I2C-Slave, uinput (Eingaben injizieren)
# CONFIG_SPI_SPIDEV is not set
# CONFIG_SPI_GPIO is not set
# CONFIG_I2C_SLAVE is not set
# CONFIG_I2C_SLAVE_EEPROM is not set
# CONFIG_INPUT_UINPUT is not set

# Grund: Kernel-Angriffsflaeche ohne Nutzen auf dem Geraet: Magic-SysRq, uevent-Helfer, erzwungenes Modul-Laden, User-Namespaces (Privilege-Escalation-Klassiker), io_uring, beschreibbare Temperatur-Grenzen
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_UEVENT_HELPER is not set
# CONFIG_MODULE_FORCE_LOAD is not set
# CONFIG_USER_NS is not set
# CONFIG_IO_URING is not set
# CONFIG_THERMAL_WRITABLE_TRIPS is not set
# CONFIG_THERMAL_EMULATION is not set
