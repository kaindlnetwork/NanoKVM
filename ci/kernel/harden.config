# Haertungsoptionen, die der Sipeed-Kernel nicht setzt und Kernel 5.10 auf
# riscv anbietet. Format: Kconfig-Fragment. Herleitung: docs/fork/kernel/README.md

# Grund: Kernel-Text und Rodata schreibgeschuetzt
CONFIG_STRICT_KERNEL_RWX=y

# Grund: Kopien zwischen Kernel und Userspace auf Objektgrenzen pruefen
CONFIG_HARDENED_USERCOPY=y

# Grund: Heap-Haertung gegen Freelist-Manipulation und vorhersagbare Layouts
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y

# Grund: Speicher vor Uebergabe nullen, kein Leck alter Inhalte
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y

# Grund: dmesg mit Kernel-Adressen nur fuer root lesbar
CONFIG_SECURITY_DMESG_RESTRICT=y
